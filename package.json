{
  "name": "@ensdomains/address-encoder",
  "version": "3.0.0",
  "description": "Encodes and decodes address formats for various cryptocurrencies",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./async": {
      "types": "./dist/async.d.ts",
      "default": "./dist/async.js"
    },
    "./coins": {
      "types": "./dist/coins.d.ts",
      "default": "./dist/coins.js"
    },
    "./coders": {
      "types": "./dist/coders.d.ts",
      "default": "./dist/coders.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/",
    "!src/**/*.test.ts",
    "!src/**/*.bench.ts",
    "!**/*.tsbuildinfo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensdomains/address-encoder.git"
  },
  "license": "MIT",
  "scripts": {
    "generateCoin": "bun ./scripts/generateCoin.ts",
    "clean": "rm -rf ./dist && rm -rf ./tsconfig.build.tsbuildinfo",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "lint": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "bun-types": "1.0.22",
    "mitata": "^0.1.14",
    "ts-arithmetic": "^0.1.1",
    "ts-markdown": "^1.3.0",
    "typescript": "^7"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "cborg": "^6.1.3"
  }
}
